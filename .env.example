# =============================================================================
# IV-fitter Web UI MVP — Environment Variables
# Copy this file to .env and adjust values as needed.
# =============================================================================

# --- Frontend (Vite) ---

# Override the auto-detected backend API base URL.
# Default: auto-detect from browser location (port 5173 -> localhost:8000).
# VITE_API_BASE=http://127.0.0.1:8000

# API token sent with every request to the backend.
# Must match IVFITTER_API_TOKEN on the backend side.
# VITE_IVFITTER_API_TOKEN=

# --- Backend (FastAPI / Uvicorn) ---

# Comma-separated list of allowed CORS origins.
# IVFITTER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Simple API token for protecting non-local deployments.
# Leave empty to disable authentication (suitable for localhost-only use).
# IVFITTER_API_TOKEN=

# When true, 500 errors return full exception details (development only).
# IVFITTER_DEBUG_ERRORS=false

# Maximum number of characters accepted for CSV text import (default: 5000000).
# IVFITTER_MAX_IMPORT_TEXT_CHARS=5000000

# Maximum number of data points accepted for a single fit (default: 50000).
# IVFITTER_MAX_FIT_POINTS=50000

# Maximum number of concurrent fitting requests (default: 2).
# IVFITTER_MAX_CONCURRENT_FITS=2

# Token-bucket rate limit: requests per minute per client IP (default: 600).
# Set to 0 to disable rate limiting.
# IVFITTER_RATE_LIMIT_PER_MIN=600

